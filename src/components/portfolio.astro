---
import "../styles/global.css";
import { ui, projects, experiments } from "../data/translations.js";

interface Props {
  lang: "fr" | "en";
}

const { lang } = Astro.props;
const t = ui[lang];

// Helper to determine if a URL should be an iframe or a raw video, and format YouTube links
const getMediaInfo = (url: string) => {
  if (!url) return { type: "video", src: "" };
  // Google Drive
  if (url.includes("drive.google.com")) return { type: "iframe", src: url };

  // YouTube standard link (watch?v=...)
  if (url.includes("youtube.com/watch")) {
    const urlObj = new URL(url);
    const videoId = urlObj.searchParams.get("v");
    return {
      type: "iframe",
      src: `https://www.youtube.com/embed/${videoId}?autoplay=1&mute=1&loop=1&playlist=${videoId}&controls=1`,
    };
  }

  // YouTube shortened link (youtu.be/...)
  if (url.includes("youtu.be/")) {
    const videoId = url.split("youtu.be/")[1].split("?")[0];
    return {
      type: "iframe",
      src: `https://www.youtube.com/embed/${videoId}?autoplay=1&mute=1&loop=1&playlist=${videoId}&controls=1`,
    };
  }

  // Fallback for direct .mp4 or .webm files
  return { type: "video", src: url };
};
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/portfolio/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>Tom - Dev | Game Maker</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/lipis/flag-icons@7.2.3/css/flag-icons.min.css"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;500;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body
    class="bg-slate-950 text-slate-200 font-['Space_Grotesk'] antialiased selection:bg-purple-500 selection:text-white"
  >
    <main class="max-w-4xl mx-auto px-6 py-24">
      <header class="mb-32 animate-fade-in-up relative">
        <a
          href={t.langLink}
          class="absolute top-0 right-0 px-4 py-2 bg-slate-900 border border-slate-700 hover:border-purple-500 rounded-lg text-sm font-medium transition-colors z-50 flex items-center gap-2"
        >
          <span class={`fi ${lang === "fr" ? "fi-gb" : "fi-fr"}`}></span>
          {t.langSwitch}
        </a>
        <div
          class="inline-block px-3 py-1 mb-4 border border-purple-500/30 rounded-full bg-purple-500/10 text-purple-400 text-sm font-medium mt-12 sm:mt-0"
        >
          {t.status}
        </div>
        <h1
          class="text-5xl md:text-7xl font-bold text-white tracking-tight mb-6"
        >
          {t.hero1}
          <br />
          <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-blue-400"
          >
            {t.hero2}
          </span>
        </h1>
      </header>

      <section class="mb-32">
        <h2
          class="text-sm font-bold text-slate-500 uppercase tracking-widest mb-8"
        >
          {t.sectionMain}
        </h2>

        {
          projects.map((project) => (
            <article class="group relative bg-slate-900 rounded-2xl border border-slate-800 overflow-hidden hover:border-purple-500/50 transition-colors duration-500 mb-10">
              <div class="aspect-video w-full bg-slate-950 relative overflow-hidden">
                {project.videoUrl ? (
                  getMediaInfo(project.videoUrl).type === "iframe" ? (
                    <iframe
                      src={getMediaInfo(project.videoUrl).src}
                      class="w-full h-full object-cover border-0"
                      allow="autoplay; encrypted-media; fullscreen"
                      allowfullscreen
                    />
                  ) : (
                    <video
                      class="w-full h-full object-cover"
                      autoplay
                      muted
                      loop
                      playsinline
                      controls
                      preload="metadata"
                    >
                      <source src={project.videoUrl} type="video/mp4" />
                      Your browser does not support HTML5 video.
                    </video>
                  )
                ) : (
                  <div class="absolute inset-0 flex items-center justify-center bg-[radial-gradient(circle_at_20%_20%,rgba(168,85,247,0.22),transparent_40%),radial-gradient(circle_at_80%_70%,rgba(56,189,248,0.2),transparent_40%),linear-gradient(135deg,#0f172a,#020617)]">
                    <div class="text-center px-6">
                      <span class="inline-block mb-4 px-3 py-1 rounded-full border border-white/20 bg-white/10 text-xs tracking-wider uppercase text-slate-200">
                        {t.wipBadge}
                      </span>
                      <p class="text-xl md:text-2xl font-bold text-white mb-2">
                        {t.wipTitle}
                      </p>
                      <p class="text-slate-300">{t.wipDesc}</p>
                    </div>
                  </div>
                )}

                <div class="absolute bottom-6 left-6 z-10">
                  {project.isWebGL && (
                    <span class="inline-flex items-center gap-2 px-3 py-1 bg-black/50 backdrop-blur rounded text-xs text-white border border-white/20 mb-2">
                      <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse" />
                      {t.webgl}
                    </span>
                  )}
                </div>
              </div>

              <div class="p-8 flex flex-col md:flex-row md:items-center justify-between gap-6">
                <div>
                  <h3 class="text-3xl font-bold text-white mb-2">
                    {project.title}
                  </h3>
                  {project.role && (
                    <div class="flex items-start gap-3 p-3 mb-5 bg-purple-500/10 border border-purple-500/20 rounded-lg text-sm text-purple-200 w-fit">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="opacity-70 mt-0.5 shrink-0"
                      >
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                      </svg>
                      <div
                        class="leading-relaxed"
                        set:html={project.role[lang]}
                      />
                    </div>
                  )}
                  <p class="text-slate-400 mb-4 text-justify">
                    {project.description[lang]}
                  </p>
                  <div class="flex flex-wrap gap-2">
                    {project.tags[lang].map((tag) => (
                      <span class="text-xs font-mono px-2 py-1 bg-slate-800 text-slate-300 rounded border border-slate-700">
                        {tag}
                      </span>
                    ))}
                  </div>
                </div>

                <div class="flex flex-col sm:flex-row gap-3">
                  <a
                    href={project.playUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center justify-center gap-2 bg-white text-black px-6 py-3 rounded-lg font-bold hover:bg-purple-400 hover:scale-105 transition-all duration-300"
                  >
                    {t.btnPlay}
                  </a>

                  {project.onePager ? (
                    <a
                      href={project.onePager}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex items-center justify-center gap-2 px-6 py-3 rounded-lg font-bold border border-cyan-300/40 text-cyan-200 bg-cyan-500/10 hover:bg-cyan-400/20 hover:scale-105 transition-all duration-300"
                    >
                      {t.btnOnePager}
                    </a>
                  ) : (
                    <span class="flex items-center justify-center px-6 py-3 rounded-lg font-bold border border-slate-700 text-slate-500 bg-slate-800/40 cursor-not-allowed">
                      {t.btnOnePagerSoon}
                    </span>
                  )}
                </div>
              </div>
            </article>
          ))
        }
      </section>

      <section>
        <h2
          class="text-sm font-bold text-slate-500 uppercase tracking-widest mb-8 border-b border-slate-800 pb-4"
        >
          {t.sectionOther}
        </h2>
        <ul class="space-y-2">
          {
            experiments.map((item) => (
              <li>
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex items-center justify-between py-3 px-4 rounded-lg hover:bg-slate-900 transition-colors"
                >
                  <span class="font-medium text-slate-300 group-hover:text-purple-400 transition-colors flex items-center gap-3">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="opacity-50 group-hover:opacity-100"
                    >
                      <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
                    </svg>
                    {typeof item.name === "string"
                      ? item.name
                      : item.name[lang]}
                  </span>
                  <span class="text-sm font-mono text-slate-500">
                    {item.tech}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section
        class="mt-20 p-8 rounded-2xl bg-gradient-to-r from-slate-900 to-slate-800 border border-slate-700/50 text-center"
      >
        <h2 class="text-xl font-bold text-white mb-3">{t.bonusTitle}</h2>
        <p
          class="text-slate-400 mb-6 max-w-2xl mx-auto"
          set:html={t.bonusDesc}
        />
        <a
          href="mailto:btomgh@gmail.com"
          class="inline-flex items-center gap-2 bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-600 px-6 py-3 rounded-lg font-medium transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><rect width="20" height="16" x="2" y="4" rx="2"></rect><path
              d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg
          >
          {t.btnAccess}
        </a>
      </section>

      <footer
        class="mt-32 pt-8 border-t border-slate-900 text-center text-slate-600 text-sm"
      >
        <p>{t.footer}</p>
      </footer>
    </main>
  </body>
</html>
