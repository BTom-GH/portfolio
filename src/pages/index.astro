---
// src/pages/index.astro
// C'est ici le "Frontmatter" (JavaScript qui s'exécute au build)
// Tu peux importer des composants ou définir des variables ici.
import "../styles/global.css";

const projects = [
  {
    title: "Broloc",
    description: "Broloc est un party game stratégique et compétitif, mais avec une particularité : ici, le meilleur colocataire n'est pas celui qui range… c'est celui qui sabote !",
    tags: ["Unreal Engine 5","Coop Local","C++", "Party game"],
    videoUrl: "https://drive.google.com/file/d/1BITt79XeqNWvfl0EwJt67RNAx3eJHLTb/preview", // Tu devras mettre ta vidéo ici
    playUrl: "https://drive.google.com/file/d/1JWwJ79N0e4MmdFoURaYLSReWqtVd7i_L/view?usp=drive_link", // Lien vers le jeu
    isWebGL: false, // Indicateur si jouable directement
	onePager: "/portfolio/docs/OnePager_BROLOC.pdf" // Lien vers le one-pager
  },
 {
    title: "Panik At The Market",
    description: "PATM : Le chaos en rayon ! PATM est un party game survolté où faire ses courses devient un sport extrême. Votre mission : compléter votre liste et foncer à la caisse avant la fin du chrono. Mais attention, la physique est contre vous !",
    tags: ["Unreal Engine 5","Coop Local","C++"],
    videoUrl: "", // Tu devras mettre ta vidéo ici
    playUrl: "", // Lien vers le jeu
    isWebGL: false, // Indicateur si jouable directement
	onePager: "/portfolio/docs/OnePager_PATM.pdf" // Lien vers le one-pager
  },
   {
    title: "Network Shooter",
    description: "Implémentation d'un petit jeu de tir en réseau avec Unreal Engine 5 pour se familiariser avec la réplication et les concepts de base du networking avec UE5. Le projet inclut des mécaniques de tir, de déplacement et de synchronisation des états entre les clients et le serveur avec du lag compensation.",
    tags: ["Unreal Engine 5","Réseau","Réplication","Lag compensation","C++"],
    videoUrl: "https://drive.google.com/file/d/1aX4XXdPQhqUeCLQn_Q3b4uEY5pOmr7Nv/preview",
    playUrl: "https://drive.google.com/file/d/1rLPAmNh2pA_oKraQniBGph4UiLyNU3kB/view?usp=drive_link",
    isWebGL: false, // Indicateur si jouable directement
	onePager: "/portfolio/docs/OnePager_Network Shooter.pdf" // Lien vers le one-pager
  },
    {
    title: "Doom-2077",
    description: "Doom-2077 is a multiplayer video game that is inspired by the principles of the original Doom, released in 1993. The game features retro graphics similar to Doom, but with modern gameplay mechanics.\n In Doom2077, the goal is simple: kill as many enemy players as possible. The game is played online, with 2 to 4 players. The single player mode allows you to discover the map.",
    tags: ["C","Multiplayer","SDL2"],
    videoUrl: "https://drive.google.com/file/d/1O8ei8NHAw6zsIEx1JeqVfvLRoma8hb3r/preview", // Tu devras mettre ta vidéo ici
    playUrl: "https://github.com/Esteban795/DOOM-2077", // Lien vers le jeu
    isWebGL: false, // Indicateur si jouable directement
	onePager: "" // Lien vers le one-pager
  }
];

const experiments = [
  { name: "Weather app in VR", tech: "Unity & C#", url: "https://github.com/Esteban795/vreather" },
  { name: "Vérification formelle de protocole crypto : Tamarin", tech: "Haskell", url: "https://github.com/tamarin-prover/tamarin-prover" },
  { name: "Portfolio V1", tech: "Astro", url: "https://github.com/BTom-GH/portfolio" },
];
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/portfolio/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<title>Tom - Dev | Game Programmer</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;500;700&display=swap" rel="stylesheet">
	</head>
	
    <body class="bg-slate-950 text-slate-200 font-['Space_Grotesk'] antialiased selection:bg-purple-500 selection:text-white">
		
        <main class="max-w-4xl mx-auto px-6 py-24">
            
            <header class="mb-32 animate-fade-in-up">
                <div class="inline-block px-3 py-1 mb-4 border border-purple-500/30 rounded-full bg-purple-500/10 text-purple-400 text-sm font-medium">
                    🟢 Open to internship
                </div>
                <h1 class="text-5xl md:text-7xl font-bold text-white tracking-tight mb-6">
                    Salut, moi c'est Tom. <br />
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-blue-400">
                        Je crée des jeux (entre autres).
                    </span>
                </h1>
            </header>

            <section class="mb-32">
                <h2 class="text-sm font-bold text-slate-500 uppercase tracking-widest mb-8">Projet Principal</h2>
                
                {projects.map((project) => (
                <article class="group relative bg-slate-900 rounded-2xl border border-slate-800 overflow-hidden hover:border-purple-500/50 transition-colors duration-500 mb-10">
                    <div class="aspect-video w-full bg-slate-950 relative overflow-hidden">
                    {project.videoUrl ? (
                        project.videoUrl.includes('drive.google.com') ? (
                            <iframe 
                                src={project.videoUrl} 
                                class="w-full h-full object-cover border-0" 
                                allow="autoplay" 
                                allowfullscreen>
                            </iframe>
                        ) : (
                            <video
                            class="w-full h-full object-cover"
                            autoplay
                            muted
                            loop
                            playsinline
                            controls
                            preload="metadata"
                            >
                            <source src={project.videoUrl} type="video/mp4" />
                            Ton navigateur ne supporte pas la vidéo HTML5.
                            </video>
                        )
                    ) : (
                        <div class="absolute inset-0 flex items-center justify-center bg-[radial-gradient(circle_at_20%_20%,rgba(168,85,247,0.22),transparent_40%),radial-gradient(circle_at_80%_70%,rgba(56,189,248,0.2),transparent_40%),linear-gradient(135deg,#0f172a,#020617)]">
                        <div class="text-center px-6">
                            <span class="inline-block mb-4 px-3 py-1 rounded-full border border-white/20 bg-white/10 text-xs tracking-wider uppercase text-slate-200">
                            Work in progress
                            </span>
                            <p class="text-xl md:text-2xl font-bold text-white mb-2">
                            Le trailer n'est pas encore sorti
                            </p>
                            <p class="text-slate-300">
                            Ca arrive tres bientot. ⏳
                            </p>
                        </div>
                        </div>
                    )}

                    <div class="absolute bottom-6 left-6 z-10">
                        {project.isWebGL && (
                        <span class="inline-flex items-center gap-2 px-3 py-1 bg-black/50 backdrop-blur rounded text-xs text-white border border-white/20 mb-2">
                            <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
                            Jouable dans le navigateur
                        </span>
                        )}
                    </div>
                    </div>

                    <div class="p-8 flex flex-col md:flex-row md:items-center justify-between gap-6">
                    <div>
                        <h3 class="text-3xl font-bold text-white mb-2">{project.title}</h3>
                        <p class="text-slate-400 mb-4 text-justify">{project.description}</p>
                        <div class="flex flex-wrap gap-2">
                        {project.tags.map((tag) => (
                            <span class="text-xs font-mono px-2 py-1 bg-slate-800 text-slate-300 rounded border border-slate-700">
                            {tag}
                            </span>
                        ))}
                        </div>
                    </div>

                    <div class="flex flex-col sm:flex-row gap-3">
                        <a
                        href={project.playUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex items-center justify-center gap-2 bg-white text-black px-6 py-3 rounded-lg font-bold hover:bg-purple-400 hover:scale-105 transition-all duration-300"
                        >
                        JOUER
                        </a>

                        {project.onePager ? (
                        <a
                            href={project.onePager}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="flex items-center justify-center gap-2 px-6 py-3 rounded-lg font-bold border border-cyan-300/40 text-cyan-200 bg-cyan-500/10 hover:bg-cyan-400/20 hover:scale-105 transition-all duration-300"
                        >
                            ONE PAGER
                        </a>
                        ) : (
                        <span class="flex items-center justify-center px-6 py-3 rounded-lg font-bold border border-slate-700 text-slate-500 bg-slate-800/40 cursor-not-allowed">
                            ONE PAGER BIENTOT
                        </span>
                        )}
                    </div>
                    </div>
                </article>
                ))}
            </section>

            <section>
                <h2 class="text-sm font-bold text-slate-500 uppercase tracking-widest mb-8 border-b border-slate-800 pb-4">Autres Expérimentations & Code</h2>
                <ul class="space-y-2">
                    {experiments.map((item) => (
                        <li>
                            <a href={item.url} target="_blank" rel="noopener noreferrer" class="group flex items-center justify-between py-3 px-4 rounded-lg hover:bg-slate-900 transition-colors">
                                <span class="font-medium text-slate-300 group-hover:text-purple-400 transition-colors flex items-center gap-3">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-50 group-hover:opacity-100"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
                                    {item.name}
                                </span>
                                <span class="text-sm font-mono text-slate-500">{item.tech}</span>
                            </a>
                        </li>
                    ))}
                </ul>
            </section>

              <section class="mt-20 p-8 rounded-2xl bg-gradient-to-r from-slate-900 to-slate-800 border border-slate-700/50 text-center">
                <h2 class="text-xl font-bold text-white mb-3">Bonus</h2>
                <p class="text-slate-400 mb-6 max-w-2xl mx-auto">
                    J'ai également un GitLab étudiant contenant des projets plus académiques et variés (comme par exemple un <span class="text-purple-400 font-mono text-sm bg-purple-400/10 px-2 py-0.5 rounded">compilateur Mini-Python</span> ou un <span class="text-purple-400 font-mono text-sm bg-purple-400/10 px-2 py-0.5 rounded">CodeNames en JavaFX</span>).
                </p>
                <a href="mailto:btomgh@gmail.com" class="inline-flex items-center gap-2 bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-600 px-6 py-3 rounded-lg font-medium transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                    Me demander l'accès
                </a>
            </section>

            <footer class="mt-32 pt-8 border-t border-slate-900 text-center text-slate-600 text-sm">
                <p>&copy; 2026 Tom. Construit avec Astro & Tailwind.</p>
            </footer>

        </main>
	</body>
</html>